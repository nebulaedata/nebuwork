# Copy to .env (ignored by Git). Reuse existing infrastructure with a dedicated engine schema.
# URL-encode reserved characters in database and Redis passwords.
DATABASE_URL=mysql://USERNAME:PASSWORD@192.168.204.128:3306/nebu_agent_engine
REDIS_URL=redis://:PASSWORD@192.168.204.128:6379/0
# Redis Pub/Sub is not isolated by logical database number; use a unique channel prefix.
REDIS_CHANNEL_PREFIX=nebu-agent-engine
S3_ENDPOINT=http://192.168.204.1:9000
S3_REGION=us-east-1
S3_BUCKET=mrtoken
S3_PREFIX=nebu-agent-engine
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Must match the platform Settings > 智能体引擎 credentials. Keep existing values on redeploy.
ENGINE_SIGNING_KEY=
BUSINESS_API_KEY=
BUSINESS_API_URL=http://host.docker.internal:42020/nwaa
