{
  "name": "nebu-agent-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:distributed": "vitest run --config vitest.distributed.config.ts",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "start:worker": "node --env-file=.env scripts/start-worker.mjs",
    "start:platform-mcp": "node --env-file=.env dist/platform-mcp-main.js",
    "dev:platform-mcp": "node --env-file=.env --import tsx src/platform-mcp-main.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "usage:backfill": "node --env-file=.env --import tsx src/backfill-usage.ts",
    "infra:prepare": "node ops/prepare-infrastructure.mjs",
    "infra:check": "node ops/prepare-infrastructure.mjs",
    "contracts:export": "tsx scripts/export-contracts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@fastify/swagger": "^9.5.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dockerode": "5.0.1",
    "es-module-lexer": "1.7.0",
    "esbuild": "0.28.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "mysql2": "^3.15.1",
    "parse5": "7.3.0",
    "tar-stream": "^3.1.7",
    "typebox": "1.3.27",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.19.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
