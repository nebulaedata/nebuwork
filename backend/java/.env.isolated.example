# Start-Local.ps1 -Isolated creates .qa/isolated.env with random local credentials.
# These values are for isolated Compose services, never the existing deployment.
NEBU_API_PORT=42020
NEBU_MYSQL_PORT=43316
NEBU_REDIS_LOCAL_PORT=46389
NEBU_DB_PASSWORD=replace-with-random-database-password
NEBU_MYSQL_ROOT_PASSWORD=replace-with-random-root-password
NEBU_REDIS_HOST=redis
NEBU_REDIS_PORT=6379
NEBU_REDIS_DATABASE=0
NEBU_REDIS_PASSWORD=replace-with-random-redis-password
NEBU_MODELS_ENCRYPTION_KEY=
# For existing encrypted data, reuse its original encryption keys.
NEBU_KNOWLEDGE_ENCRYPTION_KEY=
# For unified login, use the user service's actual Redis instance and database.
# A host service is normally reachable from Docker at host.docker.internal.
NEBU_ALLOWED_ORIGINS=*
