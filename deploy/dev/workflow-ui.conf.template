map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name _;
    client_max_body_size 100m;
    auth_basic "NebuWork Workflow";
    auth_basic_user_file /etc/nginx/workflow-ui.htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        return 200 "ok\n";
    }
    location / {
        proxy_pass http://workflow:8765;
        proxy_http_version 1.1;
        proxy_set_header Host workflow;
        proxy_set_header Origin "";
        proxy_set_header Authorization "Bearer ${WORKFLOW_API_KEY}";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
