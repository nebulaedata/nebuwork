# Public frontend configuration only. The Docker dev gateway is started by scripts/Start-Dev.ps1.
VITE_API_PREFIX=/nebulaedev
VITE_PROXY_TARGET=http://127.0.0.1:18080
# Login fetches its RSA public key from the Java account service; no embedded identity-service key.
# Optional business-only override; defaults to VITE_API_PREFIX + /nwaa.
# VITE_API_BASE_URL=/nebulaedev/nwaa
