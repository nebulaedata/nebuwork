# Use percent encoding for reserved characters in usernames/passwords.
NEBULAEKNO_DATABASE_URL=postgresql://nebulaekno:ENCODED_PASSWORD@postgres-host:5432/nebulaekno
NEBULAEKNO_NEO4J_URL=bolt://neo4j:ENCODED_PASSWORD@graph-host:7687
NEBULAEKNO_REDIS_URL=redis://default:ENCODED_PASSWORD@redis-host:6379/0
NEBULAEKNO_PORT=8080
NEBULAEKNO_DATA_DIR=/data
NEBULAEKNO_EXTRACTION_URL=http://extraction:8082
NEBULAEKNO_EXTRACTION_PORT=19082
NEBULAEKNO_EXTRACTION_CONTAINER_PORT=8082
# The extraction service uses NEBULAEKNO_MAIN_API_URL for its internal model gateway.
NEBULAEKNO_CONNECT_TIMEOUT_SECONDS=10
NEBULAEKNO_CONNECT_RETRY_WINDOW_SECONDS=60
NEBULAEKNO_INITIALIZATION_TIMEOUT_SECONDS=600
NEBULAEKNO_INITIALIZATION_LOCK_TIMEOUT_SECONDS=60
NEBULAEKNO_DEPENDENCY_RECOVERY_SECONDS=60

# Optional processing budgets; model endpoints/credentials are configured in the admin UI.
NEBULAEKNO_DOCUMENT_WORKERS=2
NEBULAEKNO_IMAGE_WORKERS=2
NEBULAEKNO_MEDIA_WORKERS=1
NEBULAEKNO_MODEL_MAX_CONCURRENCY=4
NEBULAEKNO_MAX_UPLOAD_MIB=2048
NEBULAEKNO_MEDIA_MAX_UPLOAD_MIB=2048
NEBULAEKNO_MEDIA_MAX_DURATION_SECONDS=14400

# ZIP upload and recursive extraction limits (per root archive).
NEBULAEKNO_ARCHIVE_MAX_UPLOAD_MIB=2048
NEBULAEKNO_ARCHIVE_MAX_EXPANDED_MIB=4096
NEBULAEKNO_ARCHIVE_MAX_DEPTH=8
NEBULAEKNO_ARCHIVE_MAX_FILES=10000
