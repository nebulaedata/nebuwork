# Set the existing runtime directory containing state.sqlite3 and its artifacts.
# Keep its absolute location so historical artifact and interpreter paths remain valid.
NEBULAE_RUNTIME_DIR=
NEBULAE_HOST=127.0.0.1
NEBULAE_PORT=8765
NEBULAE_WORKERS=4
NEBULAE_REMOTE_ACCESS=false
NEBULAE_TRUSTED_HOSTS=
# Reuse the existing key if remote access was configured; do not generate a replacement.
NEBULAE_SERVICE_API_KEY=
NEBULAE_WORKFLOW_URL=http://127.0.0.1:8765
